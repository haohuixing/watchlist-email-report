# Gmail address that sends the report.
SMTP_USERNAME=you@gmail.com
# 16-character Google app password (Google Account > Security > App passwords).
SMTP_PASSWORD=your-app-password
# One or more recipients, separated by commas.
MAIL_TO=you@gmail.com
# Optional. Defaults to SMTP_USERNAME.
MAIL_FROM=
# Optional. Rows per email; large lists are sent as numbered batches.
REPORT_BATCH_SIZE=50
# Optional. Seconds between Google Finance quote requests.
QUOTE_DELAY_SECONDS=0.8
